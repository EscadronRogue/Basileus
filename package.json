{
  "name": "basileus-game",
  "version": "0.1.0",
  "description": "A 3-5 player browser strategy game of dynastic profiteering inside the Byzantine Empire, with WebSocket multiplayer and strategic AI seats.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "EscadronRogue",
  "homepage": "https://github.com/EscadronRogue/Basileus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EscadronRogue/Basileus.git"
  },
  "bugs": {
    "url": "https://github.com/EscadronRogue/Basileus/issues"
  },
  "keywords": [
    "game",
    "strategy",
    "byzantine",
    "browser-game",
    "websocket",
    "multiplayer",
    "ai"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "serve": "node multiplayer/server.js",
    "serve:multiplayer": "node multiplayer/server.js",
    "simulate:ai": "node ai/simulate.js",
    "train:ai": "node ai/train.js",
    "build:svg-fallback": "node scripts/build-svg-fallback.js",
    "test": "npm run test:data && npm run test:economy && npm run test:ai && npm run test:ui && npm run test:multiplayer",
    "test:data": "node --test data/data.test.js render/svgAssets.test.js scripts/layering.test.js",
    "test:economy": "node engine/economy.test.js",
    "test:ai": "node --test ai/brain.test.js ai/purge.test.js game/save.test.js",
    "test:ui": "node ui/gameController.test.js",
    "test:multiplayer": "node --test multiplayer/server.test.js multiplayer/service.test.js && node multiplayer/verify.js",
    "test:browser": "node --test --test-concurrency=1 e2e/smoke.test.js"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
